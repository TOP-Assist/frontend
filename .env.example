# Copy this file to `.env` to override the defaults of the development server.
# The production container does not read this file; there, nginx proxies to the
# `backend` service defined in the compose stack.

# Backend that `npm run dev` proxies `/v1` requests to.
API_PROXY_TARGET=http://localhost:8000
