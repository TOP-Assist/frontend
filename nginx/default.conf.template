server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Enable response compression.
    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Vue SPA.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Always revalidate the entrypoint.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Content-hashed frontend assets.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Re-resolve the backends after container restarts.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    set $admin_backend ${ADMIN_API_PROXY_TARGET};

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Public landing-page description.
    location = /v1/description {
        limit_except GET {
            deny all;
        }

        proxy_pass $admin_backend;
    }

    # Public feedback categories.
    location = /v1/feedback/categories {
        limit_except GET {
            deny all;
        }

        proxy_pass $admin_backend;
    }

    # Public feedback submission.
    location = /v1/feedback {
        limit_except POST {
            deny all;
        }

        proxy_pass $admin_backend;
    }

    # TOP Assist backend API.
    location /v1/ {
        set $backend http://backend:8000;
        proxy_pass $backend;

        # LLM translations can outlast nginx's default timeout.
        proxy_read_timeout 300s;
    }
}