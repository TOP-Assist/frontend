server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Enable response compression.
    gzip on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Vue SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Always revalidate the entrypoint so clients pick up new asset hashes.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Vite emits content-hashed file names here, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Re-resolve the backend periodically so that nginx follows it to a new
    # address after a container restart. The resolver is filled in from
    # /etc/resolv.conf by the nginx image's entrypoint at container start.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Backend API
    location /v1/ {
        set $backend http://backend:8000;
        proxy_pass $backend;

        proxy_http_version 1.1;
        # LLM translations can outlast nginx's 60s default.
        proxy_read_timeout 300s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
